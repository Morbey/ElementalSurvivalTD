<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="run-status" picking-mode="Ignore">
        <ui:Label name="wave-label" picking-mode="Ignore" />
        <ui:Label name="lives-label" picking-mode="Ignore" />
        <ui:Label name="gold-label" picking-mode="Ignore" />
        <ui:Label name="next-wave-label" picking-mode="Ignore" />
    </ui:VisualElement>
    <ui:Label name="message" picking-mode="Ignore" />
    <ui:VisualElement name="end-screen">
        <ui:Label name="end-title" picking-mode="Ignore" />
        <ui:Button name="restart-button" text="Restart" />
    </ui:VisualElement>
</ui:UXML>
