/* Values: docs/art/visual-direction.md, section 1.3. The bars are the only place their sizes live (ADR 0002). */

.hud-text {
    margin: 0;
    padding: 0;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    white-space: nowrap;
}

/* Top bar */

#top-bar {
    flex-shrink: 0;
    height: 44px;
    padding: 0 16px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

#run-labels {
    flex-direction: row;
    align-items: center;
}

#wave-label,
#lives-label,
#next-wave-label {
    font-size: 20px;
}

#lives-label {
    margin-left: 24px;
}

#next-wave-label {
    -unity-text-align: middle-right;
}

/* The row between the bars: the area the camera frames the board into, and the side column */

#board-row {
    flex-grow: 1;
    flex-direction: row;
}

#board-area {
    flex-grow: 1;
}

#side-column {
    flex-shrink: 0;
}

/* The column shows the buy buttons, or the tower panel while side-column--tower is on (TowerPanelView). */

#tower-panel {
    display: none;
    flex-grow: 1;
}

#side-column.side-column--tower #tower-bar {
    display: none;
}

#side-column.side-column--tower #tower-panel {
    display: flex;
}

/* Tower panel: placement only. Header, stats and actions keep their size; the synergies take what is left. */

#tower-panel-header,
.stat-row,
#tower-actions,
.sell-button__value-line {
    flex-direction: row;
}

#tower-panel-header {
    align-items: center;
}

#tower-panel-tile,
#panel-close,
#tower-stats,
#tower-actions {
    flex-shrink: 0;
}

#tower-panel-title {
    flex-grow: 1;
}

.stat-row {
    justify-content: space-between;
}

#synergies {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

#sell-value-tail {
    display: none;
}

#sell-button.sell-button--refund #sell-value-tail {
    display: flex;
}

/* Bottom bar */

#bottom-bar {
    flex-shrink: 0;
    height: 72px;
    padding: 0 16px;
    flex-direction: row;
    align-items: center;
}

#gold-label {
    font-size: 24px;
    color: rgb(255, 194, 61);
}

#message {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 16px;
    overflow: hidden;
    font-size: 20px;
    color: rgb(255, 194, 61);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

#message.message--shown {
    opacity: 1;
    transition-duration: 0s;
}

#message.message--refusal {
    color: rgb(255, 255, 255);
}

#tower-bar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

/* Tower button. Button.tower-button outranks every .unity-button rule of the theme; :focus resets the theme's focus look. */

Button.tower-button,
Button.tower-button:focus {
    width: 152px;
    height: 56px;
    margin: 0 0 0 12px;
    padding: 0 10px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgb(69, 65, 59);
    border-width: 2px;
    border-color: rgb(107, 101, 90);
    border-radius: 6px;
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

Button.tower-button:hover,
Button.tower-button:active,
Button.tower-button:hover:active {
    background-color: rgb(87, 82, 74);
    border-color: rgb(107, 101, 90);
}

Button.tower-button.tower-button--selected,
Button.tower-button.tower-button--selected:hover,
Button.tower-button.tower-button--selected:active,
Button.tower-button.tower-button--selected:hover:active,
Button.tower-button.tower-button--selected:focus {
    padding: 0 9px;
    background-color: rgb(107, 101, 90);
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

.tower-button__key {
    width: 14px;
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: normal;
    color: rgb(181, 175, 163);
}

.tower-button__swatch {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin: 0 8px;
    border-width: 2px;
    border-color: rgb(217, 212, 200);
    border-radius: 3px;
}

.tower-button__info {
    flex-direction: column;
    justify-content: center;
}

.tower-button__name {
    margin: 0;
    padding: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.tower-button__price {
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: normal;
    color: rgb(255, 194, 61);
}

.tower-button--short .tower-button__price {
    color: rgb(255, 107, 94);
}

/* End screen */

#end-screen {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 19, 17, 0.8);
}

#end-title {
    margin-bottom: 24px;
    font-size: 48px;
    color: rgb(255, 107, 94);
}

#end-screen.end-screen--won #end-title {
    color: rgb(255, 194, 61);
}

Button#restart-button,
Button#restart-button:focus {
    margin: 0;
    padding: 10px 32px;
    background-color: rgb(69, 65, 59);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    border-radius: 6px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

Button#restart-button:hover,
Button#restart-button:active,
Button#restart-button:hover:active {
    background-color: rgb(87, 82, 74);
    border-color: rgb(255, 255, 255);
}
