/* Values: docs/art/visual-direction.md, sections 1.3, 1.5 and 2. The bars and the column are the only place their sizes live (ADR 0002). */

.hud-text {
    margin: 0;
    padding: 0;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    white-space: nowrap;
}

/* Top bar */

#top-bar {
    flex-shrink: 0;
    height: 44px;
    padding: 0 16px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(46, 44, 41);
}

#run-labels {
    flex-direction: row;
    align-items: center;
}

#wave-label,
#lives-label,
#next-wave-label {
    font-size: 20px;
}

#lives-label {
    margin-left: 24px;
}

#next-wave-label {
    -unity-text-align: middle-right;
}

/* The row between the bars: the area the camera frames the board into, and the side column */

#board-row {
    flex-grow: 1;
    flex-direction: row;
}

#board-area {
    flex-grow: 1;
}

#side-column {
    flex-shrink: 0;
    width: 216px;
    padding: 12px;
    background-color: rgb(46, 44, 41);
}

/* The column shows the buy buttons, or the tower panel while side-column--tower is on (TowerPanelView). */

#tower-bar {
    flex-direction: column;
    align-items: flex-start;
}

#tower-panel {
    display: none;
    flex-grow: 1;
}

#side-column.side-column--tower #tower-bar {
    display: none;
}

#side-column.side-column--tower #tower-panel {
    display: flex;
}

/* Tower panel: placement only. Header, stats and actions keep their size; the synergies take what is left. */

#tower-panel-header,
.stat-row,
#tower-actions,
.sell-button__value-line {
    flex-direction: row;
}

#tower-panel-header {
    align-items: center;
}

#tower-panel-tile,
#panel-close,
#tower-stats,
#tower-actions {
    flex-shrink: 0;
}

#tower-panel-title {
    flex-grow: 1;
}

.stat-row {
    justify-content: space-between;
}

#synergies {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

#sell-value-tail {
    display: none;
}

#sell-button.sell-button--refund #sell-value-tail {
    display: flex;
}

/* Bottom bar */

#bottom-bar {
    flex-shrink: 0;
    height: 72px;
    padding: 0 16px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(46, 44, 41);
}

#gold-label {
    font-size: 24px;
    color: rgb(255, 194, 61);
}

#message {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 16px;
    overflow: hidden;
    font-size: 20px;
    color: rgb(255, 194, 61);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
}

#message.message--shown {
    opacity: 1;
    transition-duration: 0s;
}

/* Tower button. Button.tower-button outranks every .unity-button rule of the theme; :focus resets the theme's focus look. */

Button.tower-button,
Button.tower-button:focus {
    width: 192px;
    height: 56px;
    margin: 0 0 8px 0;
    padding: 0 10px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgb(69, 65, 59);
    border-width: 2px;
    border-color: rgb(107, 101, 90);
    border-radius: 6px;
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

Button.tower-button:hover,
Button.tower-button:active,
Button.tower-button:hover:active {
    background-color: rgb(87, 82, 74);
    border-color: rgb(107, 101, 90);
}

Button.tower-button.tower-button--selected,
Button.tower-button.tower-button--selected:hover,
Button.tower-button.tower-button--selected:active,
Button.tower-button.tower-button--selected:hover:active,
Button.tower-button.tower-button--selected:focus {
    padding: 0 9px;
    background-color: rgb(107, 101, 90);
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

.tower-button__key {
    width: 14px;
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: normal;
    color: rgb(181, 175, 163);
}

.tower-button__swatch {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin: 0 8px;
    border-width: 2px;
    border-color: rgb(217, 212, 200);
    border-radius: 3px;
}

.tower-button__info {
    flex-direction: column;
    justify-content: center;
}

.tower-button__name {
    margin: 0;
    padding: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.tower-button__price {
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: normal;
    color: rgb(255, 194, 61);
}

.tower-button--short .tower-button__price {
    color: rgb(255, 107, 94);
}

/* Tower panel: header */

#tower-panel-tile {
    width: 28px;
    height: 28px;
    margin-right: 8px;
    border-width: 2px;
    border-color: rgb(217, 212, 200);
    border-radius: 3px;
}

#tower-panel-title {
    font-size: 18px;
}

/* Button#panel-close outranks every .unity-button rule of the theme; :focus resets the theme's focus look. */

Button#panel-close,
Button#panel-close:focus {
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(181, 175, 163);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    white-space: nowrap;
}

Button#panel-close:hover,
Button#panel-close:active,
Button#panel-close:hover:active {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
}

/* Tower panel: stats */

#tower-stats {
    margin-top: 12px;
}

.stat-row {
    height: 22px;
    align-items: center;
}

.stat-row__caption {
    font-size: 16px;
    -unity-font-style: normal;
    color: rgb(181, 175, 163);
}

.stat-row__value {
    font-size: 16px;
    -unity-text-align: middle-right;
}

/* Tower panel: synergies */

#synergies {
    margin-top: 16px;
}

#synergies-heading {
    height: 18px;
    font-size: 14px;
    color: rgb(181, 175, 163);
    -unity-text-align: middle-left;
}

#synergies-empty {
    height: 28px;
    font-size: 14px;
    -unity-font-style: normal;
    color: rgb(138, 132, 120);
    -unity-text-align: middle-left;
}

/* Tower panel: actions. Upgrade is not a button, so it has no hover or pressed look. */

#tower-actions {
    margin-top: 16px;
}

#upgrade-button {
    width: 80px;
    height: 56px;
    align-items: center;
    justify-content: center;
    background-color: rgb(58, 55, 51);
    border-width: 2px;
    border-color: rgb(79, 74, 67);
    border-radius: 6px;
}

.upgrade-button__caption {
    font-size: 16px;
    color: rgb(138, 132, 120);
}

.upgrade-button__note {
    font-size: 14px;
    -unity-font-style: normal;
    color: rgb(138, 132, 120);
}

/* Sell. Button#sell-button outranks every .unity-button rule of the theme; :focus resets the theme's focus look. */

Button#sell-button,
Button#sell-button:focus {
    width: 100px;
    height: 56px;
    margin: 0 0 0 12px;
    padding: 0 6px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgb(69, 65, 59);
    border-width: 2px;
    border-color: rgb(255, 194, 61);
    border-radius: 6px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
    white-space: nowrap;
}

Button#sell-button:hover,
Button#sell-button:active,
Button#sell-button:hover:active {
    background-color: rgb(87, 82, 74);
}

.sell-button__caption {
    font-size: 18px;
}

.sell-button__value-line {
    align-items: flex-end;
    justify-content: center;
}

#sell-value {
    font-size: 16px;
    color: rgb(255, 194, 61);
    transform-origin: right center;
}

#sell-value-tail {
    font-size: 14px;
    -unity-font-style: normal;
    color: rgb(181, 175, 163);
}

/* The refund look: a number in a darker gold, the tail with the cost, a grey border. */

Button#sell-button.sell-button--refund {
    border-color: rgb(107, 101, 90);
}

#sell-button.sell-button--refund #sell-value {
    color: rgb(201, 160, 74);
}

/* The drop. Pop: the first look, held one frame, with no transition. Settle: eases from it to the refund look. */

Button#sell-button.sell-button--pop {
    border-color: rgb(255, 107, 94);
    transition-duration: 0s;
}

#sell-button.sell-button--pop #sell-value {
    color: rgb(255, 107, 94);
    scale: 1.4 1.4;
    transition-duration: 0s;
}

Button#sell-button.sell-button--settle {
    transition-property: border-top-color, border-right-color, border-bottom-color, border-left-color;
    transition-duration: 0.5s;
    transition-delay: 0.25s;
}

#sell-button.sell-button--settle #sell-value {
    transition-property: scale, color;
    transition-duration: 0.25s, 0.5s;
    transition-delay: 0s, 0.25s;
    transition-timing-function: ease-out, ease;
}

/* Text over the board (ADR 0006): the place only. Code moves each zero-size anchor to a panel point by translate;
   the label hangs from it by its bottom centre, or by its top centre with floating-text--hang-top, so placing a label
   needs no text size (only the refusal's clamp measures its text). The looks are the kind classes. */

#floating-texts,
.floating-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.floating-anchor {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
}

.floating-text {
    position: absolute;
    left: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    translate: -50% 0;
    white-space: nowrap;
}

.floating-text.floating-text--hang-top {
    top: 0;
    bottom: auto;
}

/* Looks of text over the board: visual direction, sections 2 and 1.3. Every one has a black outline of 1 and no shadow. */

.floating-text {
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.damage-number--weak {
    font-size: 16px;
    -unity-font-style: normal;
    color: rgb(179, 172, 160);
}

.damage-number--normal {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.damage-number--strong {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 194, 61);
}

.immune-word {
    font-size: 16px;
    -unity-font-style: normal;
    color: rgb(189, 189, 189);
}

#refusal {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

/* End screen */

#end-screen {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 19, 17, 0.8);
}

#end-title {
    margin-bottom: 24px;
    font-size: 48px;
    color: rgb(255, 107, 94);
}

#end-screen.end-screen--won #end-title {
    color: rgb(255, 194, 61);
}

Button#restart-button,
Button#restart-button:focus {
    margin: 0;
    padding: 10px 32px;
    background-color: rgb(69, 65, 59);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    border-radius: 6px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

Button#restart-button:hover,
Button#restart-button:active,
Button#restart-button:hover:active {
    background-color: rgb(87, 82, 74);
    border-color: rgb(255, 255, 255);
}
